<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Backbone.App.Views.JobsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Backbone.App.ViewModels">

  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Visibility="{x:Bind ViewModel.IsListVisible, Mode=OneWay}" Grid.Row="0" Grid.RowSpan="2" RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Uid="Jobs_Title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
        <Button Grid.Column="1" x:Uid="Jobs_New" Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.NewJobCommand}" />
      </Grid>

      <InfoBar Grid.Row="1" Severity="Error" IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
               Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

      <TextBlock Grid.Row="2" x:Uid="Jobs_Empty" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                 TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <ListView Grid.Row="2" x:Name="JobsList" x:Uid="Jobs_List" ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}"
                SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnJobClick" TabIndex="2">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:JobListItem">
            <StackPanel Padding="0,8" Spacing="2" AutomationProperties.Name="{x:Bind Name}">
              <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Text="{x:Bind Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>

    <ContentPresenter x:Name="EditorHost" Grid.Row="0" Grid.RowSpan="2"
                      Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}" />
  </Grid>
</UserControl>
