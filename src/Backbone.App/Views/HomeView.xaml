<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Backbone.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Backbone.App.ViewModels">

  <ScrollViewer VerticalScrollBarVisibility="Auto" IsTabStop="False">
    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock x:Uid="Home_Title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />

      <InfoBar Severity="Error" IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
               Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

      <!-- Estado vacío (§9.3): sin trabajos. -->
      <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
        <TextBlock x:Uid="Home_Empty" TextWrapping="WrapWholeWords" />
        <Button x:Uid="Home_CreateJob" Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.CreateJobCommand}" />
      </StackPanel>

      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}">
        <ItemsRepeater.Layout>
          <StackLayout Spacing="8" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:JobCard">
            <Border Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    AutomationProperties.Name="{x:Bind Name}">
              <StackPanel Spacing="2">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Run.ProgressText, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind Run.HasProgress, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <Button Grid.Column="1" x:Uid="Run_RunNow" Command="{x:Bind Run.RunNowCommand}"
                          IsEnabled="{x:Bind Run.CanRunNow, Mode=OneWay}"
                          Visibility="{x:Bind Run.ShowRunNow, Mode=OneWay}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{x:Bind Run.CancelText, Mode=OneWay}" Command="{x:Bind Run.CancelCommand}"
                          IsEnabled="{x:Bind Run.CanCancel, Mode=OneWay}"
                          Visibility="{x:Bind Run.ShowCancel, Mode=OneWay}" VerticalAlignment="Center" />
                </Grid>
                <InfoBar Severity="Informational" IsClosable="False" Margin="0,8,0,0"
                         IsOpen="{x:Bind Run.HasNotice, Mode=OneWay}" Message="{x:Bind Run.Notice, Mode=OneWay}"
                         Visibility="{x:Bind Run.HasNotice, Mode=OneWay}" />
                <InfoBar Severity="Error" IsClosable="False" Margin="0,8,0,0"
                         IsOpen="{x:Bind Run.HasError, Mode=OneWay}" Message="{x:Bind Run.Error, Mode=OneWay}"
                         Visibility="{x:Bind Run.HasError, Mode=OneWay}" />
                <InfoBar Severity="Warning" IsClosable="False" IsOpen="True" Margin="0,8,0,0"
                         x:Uid="Repo_ReadOnly" Visibility="{x:Bind IsReadOnly}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </StackPanel>
  </ScrollViewer>
</UserControl>
