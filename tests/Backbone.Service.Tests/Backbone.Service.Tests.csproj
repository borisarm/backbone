<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Scheduler, IPC y almacenes con dobles de prueba (§11). Las pruebas con named pipes reales usan un nombre aleatorio y
    no necesitan elevación, así que corren en la batería normal; las que requieren administrador están en
    Backbone.IntegrationTests con [Trait("Category", "Integration")].
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Backbone.Service.Tests</RootNamespace>
    <!-- LibraryImport (token restringido para probar el rechazo de la ACL del pipe). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Backbone.Service\Backbone.Service.csproj" />
  </ItemGroup>

</Project>
