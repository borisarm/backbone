<?xml version="1.0" encoding="utf-8"?>
<!--
  Orígenes de paquetes de Backbone: solo nuget.org, y todo paquete se resuelve únicamente desde él
  (packageSourceMapping), para evitar confusión de dependencias con orígenes configurados en la máquina.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
